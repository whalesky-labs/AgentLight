from __future__ import annotations

import json
import sys
from datetime import datetime


EVENT_ALIASES = {
    "message": "wechat-message",
    "group": "wechat-message",
    "friend": "wechat-message",
    "other": "wechat-message",
    "important": "wechat-important",
    "muted": "wechat-muted",
    "cleared": "wechat-cleared",
    "offline": "wechat-offline",
    "error": "wechat-listener-error",
}


def emit(event: str) -> None:
    category = {
        "message": "other",
        "group": "group",
        "friend": "friend",
        "other": "other",
        "important": "friend",
        "muted": "group",
    }.get(event, "")
    conversation = {
        "group": "48293083178@chatroom",
        "friend": "wxid_test_friend",
        "other": "notifymessage",
        "message": "notifymessage",
        "important": "wxid_test_friend",
        "muted": "48293083178@chatroom",
    }.get(event, "")
    payload = {
        "source": "wechat",
        "event": EVENT_ALIASES.get(event, event),
        "platform": sys.platform,
        "conversation": conversation,
        "sender": conversation,
        "summary": "这是一条本地测试微信事件" if category else "",
        "messageCategory": category,
        "confidence": "visible-summary" if category else "diagnostic",
        "timestamp": datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z"),
    }
    if payload["event"] == "wechat-listener-error":
        payload["diagnostic"] = "fake helper listener error"
    print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))


def main() -> int:
    events = sys.argv[1:] or ["message"]
    for event in events:
        emit(event)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
