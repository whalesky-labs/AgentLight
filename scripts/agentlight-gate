#!/usr/bin/env bash
#
# This file is part of AgentLight.
#
# @link     https://github.com/whalesky-labs/AgentLight
# @document https://github.com/whalesky-labs/AgentLight/blob/main/README.md
# @contact  root@imoi.cn
# @license  https://github.com/whalesky-labs/AgentLight/blob/main/LICENSE
#

set -euo pipefail

STATE_DIR="${AGENTLIGHT_STATE_DIR:-${TMPDIR:-/tmp}/agentlight}"
STATE_FILE="${STATE_DIR}/last-event"
SESSION_STATE_FILE="${STATE_DIR}/last-session-event"
HEALTH_OVERRIDE_FILE="${STATE_DIR}/health-override"
DEFAULT_COOLDOWN_MS="300"
DEFAULT_DONE_CUE_MS="800"

usage() {
  cat <<'EOF'
AgentLight event gate

Usage:
  scripts/agentlight-gate <event>

Events:
  idle
  start
  tool
  thinking
  done
  waiting
  error
  health-waiting
  health-recovered

Environment:
  AGENTLIGHT_COOLDOWN_MS  Duplicate suppression window in milliseconds, defaults to 300
  AGENTLIGHT_DONE_CUE_MS  Completion cue duration in milliseconds, defaults to 800
  AGENTLIGHT_STATE_DIR    State cache directory
  AGENTLIGHT_HOST         Passed through to scripts/agentlight
  AGENTLIGHT_BASE_URL     Passed through to scripts/agentlight
EOF
}

now_ms() {
  python3 - <<'PY'
import time

print(time.monotonic_ns() // 1_000_000)
PY
}

assert_non_negative_integer() {
  local name="$1"
  local value="$2"

  case "$value" in
    ''|*[!0-9]*)
      printf '%s must be a non-negative integer, got: %s\n' "$name" "$value" >&2
      return 2
      ;;
  esac
}

map_event_to_state() {
  local event="$1"
  event="$(printf '%s' "$event" | tr '[:upper:]' '[:lower:]')"

  case "$event" in
    prompt)
      printf 'yellow-breathe\n'
      ;;
    idle|ready)
      printf 'green\n'
      ;;
    start|busy|running)
      printf 'yellow-blink\n'
      ;;
    tool|exec|command)
      printf 'yellow-blink\n'
      ;;
    thinking|generate|generating)
      printf 'yellow-breathe\n'
      ;;
    typing|responding)
      printf 'yellow-breathe\n'
      ;;
    done|success|complete|completed)
      printf 'green\n'
      ;;
    waiting|confirm|confirmation|blocked)
      printf 'red-blink\n'
      ;;
    health-waiting)
      printf 'red-blink\n'
      ;;
    health-recovered)
      printf 'green\n'
      ;;
    error|failed|failure)
      printf 'red\n'
      ;;
    *)
      printf 'Unknown AgentLight event: %s\n' "$1" >&2
      return 2
      ;;
  esac
}

is_health_event() {
  local event="$1"
  event="$(printf '%s' "$event" | tr '[:upper:]' '[:lower:]')"

  case "$event" in
    health-waiting|health-recovered)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_completion_event() {
  local event="$1"
  event="$(printf '%s' "$event" | tr '[:upper:]' '[:lower:]')"

  case "$event" in
    done|success|complete|completed)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

sleep_ms() {
  local delay_ms="$1"

  python3 - "$delay_ms" <<'PY'
import sys
import time

time.sleep(int(sys.argv[1]) / 1000)
PY
}

send_state() {
  local state="$1"

  "${script_dir}/agentlight" "$state"
}

record_session_state() {
  local event="$1"
  local state="$2"
  local timestamp_ms="$3"

  printf '%s|%s|%s\n' "$event" "$state" "$timestamp_ms" > "$SESSION_STATE_FILE"
}

read_session_state() {
  if [[ -f "$SESSION_STATE_FILE" ]]; then
    IFS='|' read -r session_event session_state session_ms < "$SESSION_STATE_FILE" || true
  else
    session_event="idle"
    session_state="green"
    session_ms="0"
  fi
}

if [[ $# -ne 1 || "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 2
fi

event="$1"
state="$(map_event_to_state "$event")"
cooldown_ms="${AGENTLIGHT_COOLDOWN_MS:-$DEFAULT_COOLDOWN_MS}"
assert_non_negative_integer "AGENTLIGHT_COOLDOWN_MS" "$cooldown_ms"
done_cue_ms="${AGENTLIGHT_DONE_CUE_MS:-$DEFAULT_DONE_CUE_MS}"
assert_non_negative_integer "AGENTLIGHT_DONE_CUE_MS" "$done_cue_ms"
current_ms="$(now_ms)"

mkdir -p "$STATE_DIR"

if ! is_health_event "$event"; then
  record_session_state "$event" "$state" "$current_ms"
fi

if [[ -f "$HEALTH_OVERRIDE_FILE" && "$event" != "health-recovered" && "$event" != "health-waiting" ]]; then
  printf 'SKIP health-override event=%s state=%s active=%s\n' "$event" "$state" "$(cat "$HEALTH_OVERRIDE_FILE")"
  exit 0
fi

last_event=""
last_state=""
last_ms="0"
if [[ -f "$STATE_FILE" ]]; then
  IFS='|' read -r last_event last_state last_ms < "$STATE_FILE" || true
fi

elapsed_ms=$((current_ms - ${last_ms:-0}))
if [[ "$event" == "$last_event" && "$state" == "$last_state" && "$elapsed_ms" -lt "$cooldown_ms" ]]; then
  printf 'SKIP duplicate event=%s state=%s elapsed_ms=%s window_ms=%s\n' "$event" "$state" "$elapsed_ms" "$cooldown_ms"
  exit 0
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
sent_state="$state"

if [[ "$event" == "health-waiting" ]]; then
  printf 'health-waiting|%s\n' "$current_ms" > "$HEALTH_OVERRIDE_FILE"
  send_state "$state"
elif [[ "$event" == "health-recovered" ]]; then
  rm -f "$HEALTH_OVERRIDE_FILE"
  read_session_state
  sent_state="${session_state:-green}"
  send_state "$sent_state"
elif is_completion_event "$event"; then
  cue_response="$(send_state "green-blink")"
  sleep_ms "$done_cue_ms"
  final_response="$(send_state "$state")"
  printf '%s; %s\n' "$cue_response" "$final_response"
else
  send_state "$state"
fi

printf '%s|%s|%s\n' "$event" "$sent_state" "$current_ms" > "$STATE_FILE"
